# Backend server port
PORT=43124

# Comma-separated browser origins allowed to call the API
CORS_ORIGIN=http://127.0.0.1:43123,http://localhost:43123

# Frontend reads this when present in the repo-root .env (Vite envDir).
# The app defaults to http://127.0.0.1:43124/api when the variable is unset.
# VITE_API_BASE_URL=http://127.0.0.1:43124/api

# Optional OpenAI-compatible provider for match scoring.
# Leave these unset to use the built-in local matcher. No key is required.
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
