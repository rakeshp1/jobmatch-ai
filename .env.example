# Backend server port
PORT=43124

# Comma-separated browser origins allowed to call the API
CORS_ORIGIN=http://127.0.0.1:43123,http://localhost:43123

# Optional override when the UI and API are on different origins.
# Leave unset for local Vite (it proxies /api to port 43124) and for production
# (the built app calls /api on the same origin).
# VITE_API_BASE_URL=

# Writable SQLite and upload directories. Defaults are backend/data and backend/uploads.
# DATA_DIR=
# UPLOAD_DIR=

# Optional OpenAI-compatible provider for match scoring.
# Leave these unset to use the built-in local matcher. No key is required.
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
